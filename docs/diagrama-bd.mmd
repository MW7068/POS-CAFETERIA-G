erDiagram
    direction TB

    Clientes |o..o{ Ventas : "realiza - RESTRICT"
    Ventas ||--o{ DetallesVenta : "contiene - CASCADE"
    Productos ||--o{ DetallesVenta : "referenciado por - RESTRICT"

    Clientes {
        INTEGER Id PK "Autoincremental"
        TEXT Nombre "Obligatorio"
        TEXT Celular "Opcional"
    }

    Ventas {
        INTEGER Id PK "Autoincremental"
        TEXT Fecha "DateTime en C#"
        INTEGER ClienteId FK "Opcional"
    }

    Productos {
        INTEGER Id PK "Autoincremental"
        TEXT Nombre
        TEXT Precio "decimal en C#"
        INTEGER Stock
    }

    DetallesVenta {
        INTEGER Id PK "Autoincremental"
        INTEGER VentaId FK
        INTEGER ProductoId FK
        INTEGER Cantidad
        TEXT PrecioUnitario "decimal - precio historico"
    }