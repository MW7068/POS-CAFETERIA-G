erDiagram
    Clientes ||--o{ Ventas : "realiza - RESTRICT"
    Ventas ||--|{ DetallesVenta : "contiene - CASCADE"
    Productos ||--o{ DetallesVenta : "referenciado por - RESTRICT"

    Clientes {
        int Id PK
        string Nombre
        string Celular
    }

    Ventas {
        int Id PK
        DateTime Fecha
        int ClienteId FK
    }

    Productos {
        int Id PK
        string Nombre
        decimal Precio
        int Stock
    }

    DetallesVenta {
        int Id PK
        int VentaId FK
        int ProductoId FK
        int Cantidad
        decimal PrecioUnitario
    }