                            <Grid Margin="2,0,2,4">
                                <TextBlock Text="⌨️ Teclado Interactivo Activo" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource PrimaryRed}" VerticalAlignment="Center"/>
                                <Button Content="Ocultar" Click="BtnHideKeypad_Click" HorizontalAlignment="Right" Background="Transparent"
                                        BorderThickness="0" FontSize="10.5" Foreground="{StaticResource TextMuted}" Cursor="Hand"/>
                            </Grid>

                            <UniformGrid Columns="10">
                                <Button Content="1" Style="{StaticResource FullKeypadButtonStyle}" Click="KeypadChar_Click"/>
                                <Button Content="2" Style="{StaticResource FullKeypadButtonStyle}" Click="KeypadChar_Click"/>
                                <Button Content="3" Style="{StaticResource FullKeypadButtonStyle}" Click="KeypadChar_Click"/>
                                <Button Content="4" Style="{StaticResource FullKeypadButtonStyle}" Click="KeypadChar_Click"/>
                                <Button Content="5" Style="{StaticResource FullKeypadButtonStyle}" Click="KeypadChar_Click"/>
                                <Button Content="6" Style="{StaticResource FullKeypadButtonStyle}" Click="KeypadChar_Click"/>
                                <Button Content="7" Style="{StaticResource FullKeypadButtonStyle}" Click="KeypadChar_Click"/>
                                <Button Content="8" Style="{StaticResource FullKeypadButtonStyle}" Click="KeypadChar_Click"/>
                                <Button Content="9" Style="{StaticResource FullKeypadButtonStyle}" Click="KeypadChar_Click"/>
                                <Button Content="0" Style="{StaticResource FullKeypadButtonStyle}" Click="KeypadChar_Click"/>
                            </UniformGrid>

                            <UniformGrid Columns="10">
                                <Button Content="q" Style="{StaticResource FullKeypadButtonStyle}" Click="KeypadChar_Click"/>
                                <Button Content="w" Style="{StaticResource FullKeypadButtonStyle}" Click="KeypadChar_Click"/>
                                <Button Content="e" Style="{StaticResource FullKeypadButtonStyle}" Click="KeypadChar_Click"/>
                                <Button Content="r" Style="{StaticResource FullKeypadButtonStyle}" Click="KeypadChar_Click"/>
                                <Button Content="t" Style="{StaticResource FullKeypadButtonStyle}" Click="KeypadChar_Click"/>
                                <Button Content="y" Style="{StaticResource FullKeypadButtonStyle}" Click="KeypadChar_Click"/>
                                <Button Content="u" Style="{StaticResource FullKeypadButtonStyle}" Click="KeypadChar_Click"/>
                                <Button Content="i" Style="{StaticResource FullKeypadButtonStyle}" Click="KeypadChar_Click"/>
                                <Button Content="o" Style="{StaticResource FullKeypadButtonStyle}" Click="KeypadChar_Click"/>
                                <Button Content="p" Style="{StaticResource FullKeypadButtonStyle}" Click="KeypadChar_Click"/>
                            </UniformGrid>

                            <UniformGrid Columns="9" Margin="10,0">
                                <Button Content="a" Style="{StaticResource FullKeypadButtonStyle}" Click="KeypadChar_Click"/>
                                <Button Content="s" Style="{StaticResource FullKeypadButtonStyle}" Click="KeypadChar_Click"/>
                                <Button Content="d" Style="{StaticResource FullKeypadButtonStyle}" Click="KeypadChar_Click"/>
                                <Button Content="f" Style="{StaticResource FullKeypadButtonStyle}" Click="KeypadChar_Click"/>
                                <Button Content="g" Style="{StaticResource FullKeypadButtonStyle}" Click="KeypadChar_Click"/>
                                <Button Content="h" Style="{StaticResource FullKeypadButtonStyle}" Click="KeypadChar_Click"/>
                                <Button Content="j" Style="{StaticResource FullKeypadButtonStyle}" Click="KeypadChar_Click"/>
                                <Button Content="k" Style="{StaticResource FullKeypadButtonStyle}" Click="KeypadChar_Click"/>
                                <Button Content="l" Style="{StaticResource FullKeypadButtonStyle}" Click="KeypadChar_Click"/>
                            </UniformGrid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.3*"/>
                                    <ColumnDefinition Width="7*"/>
                                    <ColumnDefinition Width="1.4*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnCapsLock" Grid.Column="0" Content="⇧" Style="{StaticResource FullKeypadButtonStyle}" Click="KeypadCaps_Click" ToolTip="Mayúsculas / Minúsculas"/>
