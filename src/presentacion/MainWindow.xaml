
<Window x:Class="PosCafeteria.Presentacion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Café de Mamá Oli | Punto de venta"
        Height="780" Width="1280"
        MinHeight="650" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        FontFamily="Segoe UI">

    <Window.Resources>

        <SolidColorBrush x:Key="PrimaryColor" Color="#C62828"/>
        <SolidColorBrush x:Key="DarkColor" Color="#8E1717"/>
        <SolidColorBrush x:Key="LightRed" Color="#FDECEC"/>
        <SolidColorBrush x:Key="MutedColor" Color="#777777"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#C62828"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#A91F1F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#801515"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FCE8E8"/>
            <Setter Property="Foreground" Value="#B71C1C"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SecondaryBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SecondaryBorder"
                                        Property="Background"
                                        Value="#F7D0D0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProductCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#EEEEEE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000"
                                      Opacity="0.06"
                                      BlurRadius="10"
                                      ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#E57373"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#C62828"
                                              Opacity="0.15"
                                              BlurRadius="15"
                                              ShadowDepth="3"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <Border Grid.Row="0" Background="#C62828">
            <Grid Margin="26,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CAFÉ DE MAMÁ OLI"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"/>
                    <TextBlock Text="Sistema de punto de venta"
                               Foreground="#FFE0E0"
                               FontSize="11"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Border Background="#A91F1F"
                            CornerRadius="18"
                            Padding="15,8"
                            Margin="0,0,12,0">
                        <TextBlock Text="VENTA NUEVA"
                                   Foreground="White"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <Border Background="White"
                            CornerRadius="18"
                            Padding="16,8">
                        <TextBlock Text="CAJA"
                                   Foreground="#C62828"
                                   FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENIDO PRINCIPAL -->
        <Grid Grid.Row="1" Margin="22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.55*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- CATÁLOGO -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="Catálogo de productos"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#292929"/>

                    <TextBlock Text="Selecciona los productos que deseas agregar a la venta."
                               Foreground="#777777"
                               Margin="0,5,0,0"
                               FontSize="13"/>

                    <TextBlock Text="PROTOTIPO: catálogo de demostración. No registra ventas."
                               Foreground="#B71C1C"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <!-- BUSCADOR Y CATEGORÍAS -->
                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="White"
                            BorderBrush="#E5E5E5"
                            BorderThickness="1"
                            CornerRadius="8">
                        <TextBox x:Name="txtBuscar"
                                 Height="40"
                                 Padding="12,8"
                                 FontSize="13"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 TextChanged="Buscar_TextChanged"
                                 ToolTip="Buscar producto"/>
                    </Border>

                    <ComboBox x:Name="cmbCategoria"
                              Grid.Column="1"
                              Height="42"
                              Margin="10,0,0,0"
                              Padding="8"
                              VerticalContentAlignment="Center"
                              SelectionChanged="Categoria_SelectionChanged"/>
                </Grid>

                <!-- PRODUCTOS -->
                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="itemsProductos">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="205"
                                        Margin="0,0,12,14"
                                        Style="{StaticResource ProductCard}">

                                    <StackPanel>
                                        <Border Background="#FCECEC"
                                                Height="85"
                                                CornerRadius="9">
                                            <TextBlock Text="{Binding Icono}"
                                                       FontSize="37"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <TextBlock Text="{Binding Nombre}"
                                                   FontWeight="Bold"
                                                   FontSize="15"
                                                   Foreground="#292929"
                                                   Margin="0,12,0,5"
                                                   TextWrapping="Wrap"/>

                                        <TextBlock Text="{Binding Categoria}"
                                                   FontSize="11"
                                                   Foreground="#888888"/>

                                        <TextBlock Text="{Binding Precio, StringFormat='S/ {0:N2}'}"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="#C62828"
                                                   Margin="0,12,0,12"/>

                                        <Button Content="+ Agregar producto"
                                                Style="{StaticResource PrimaryButton}"
                                                HorizontalAlignment="Stretch"
                                                Tag="{Binding}"
                                                Click="AgregarProducto_Click"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- SEPARADOR -->
            <Border Grid.Column="1"
                    Background="#E5E5E5"
                    Width="1"
                    HorizontalAlignment="Center"/>

            <!-- CARRITO -->
            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="14"
                    Padding="20"
                    BorderBrush="#EAEAEA"
                    BorderThickness="1">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- TÍTULO DEL CARRITO -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Detalle de venta"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#292929"/>

                        <TextBlock x:Name="txtCantidadProductos"
                                   Text="0 productos"
                                   Foreground="#888888"
                                   Margin="0,5,0,14"/>
                    </StackPanel>

                    <!-- CABECERA -->
                    <Border Grid.Row="1"
                            Background="#FCECEC"
                            CornerRadius="7"
                            Padding="10"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Producto"
                                       FontWeight="SemiBold"
                                       Foreground="#8E1717"/>

                            <TextBlock Grid.Column="1"
                                       Text="Cant."
                                       FontWeight="SemiBold"
                                       Margin="8,0"
                                       Foreground="#8E1717"/>

                            <TextBlock Grid.Column="2"
                                       Text="Importe"
                                       FontWeight="SemiBold"
                                       Foreground="#8E1717"/>
                        </Grid>
                    </Border>

                    <!-- PRODUCTOS AGREGADOS -->
                    <ListBox x:Name="listaCarrito"
                             Grid.Row="2"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#EEEEEE"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,10">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center">

                                            <TextBlock Text="{Binding Nombre}"
                                                       FontWeight="SemiBold"
                                                       Foreground="#292929"
                                                       TextWrapping="Wrap"/>

                                            <TextBlock Text="{Binding Precio, StringFormat='S/ {0:N2} c/u'}"
                                                       FontSize="11"
                                                       Foreground="#888888"
                                                       Margin="0,3,0,0"/>

                                            <StackPanel Orientation="Horizontal"
                                                        Margin="0,7,0,0">

                                                <Button Content="−"
                                                        Width="27"
                                                        Height="27"
                                                        Click="DisminuirCantidad_Click"
                                                        Tag="{Binding}"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Padding="0"/>

                                                <TextBox Text="{Binding CantidadTexto, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="42"
                                                         Height="27"
                                                         Margin="5,0"
                                                         TextAlignment="Center"
                                                         VerticalContentAlignment="Center"
                                                         PreviewTextInput="Cantidad_PreviewTextInput"
                                                         DataObject.Pasting="Cantidad_Pasting"
                                                         LostFocus="Cantidad_LostFocus"/>

                                                <Button Content="+"
                                                        Width="27"
                                                        Height="27"
                                                        Click="AumentarCantidad_Click"
                                                        Tag="{Binding}"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Padding="0"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Importe, StringFormat='S/ {0:N2}'}"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0"
                                                   Foreground="#292929"/>

                                        <Button Grid.Column="2"
                                                Content="×"
                                                Tag="{Binding}"
                                                Click="EliminarProducto_Click"
                                                Background="Transparent"
                                                Foreground="#C62828"
                                                BorderThickness="0"
                                                FontSize="21"
                                                Cursor="Hand"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- RESUMEN -->
                    <StackPanel Grid.Row="3" Margin="0,12,0,12">

                        <Border Background="#F8F8F8"
                                CornerRadius="10"
                                Padding="14">

                            <StackPanel>
                                <TextBlock Text="Resumen de la venta"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="#292929"
                                           Margin="0,0,0,12"/>

                                <TextBlock Text="Los precios mostrados son finales."
                                           FontSize="11"
                                           Foreground="#777777"
                                           Margin="0,0,0,10"/>

                                <Border Height="1"
                                        Background="#DDDDDD"
                                        Margin="0,0,0,10"/>

                                <Grid>
                                    <TextBlock Text="TOTAL"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="#292929"/>

                                    <TextBlock x:Name="txtTotal"
                                               Text="S/ 0.00"
                                               FontSize="23"
                                               FontWeight="Bold"
                                               Foreground="#C62828"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- BOTONES -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1.4*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Cancelar"
                                Style="{StaticResource SecondaryButton}"
                                Click="Cancelar_Click"/>

                        <Button x:Name="btnConfirmar"
                                Grid.Column="2"
                                Content="Confirmar venta"
                                Style="{StaticResource PrimaryButton}"
                                Click="Confirmar_Click"/>
                    </Grid>

                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
