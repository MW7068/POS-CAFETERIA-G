                    <Border Grid.Row="2" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1.5" CornerRadius="10" Padding="14" Margin="0,12,0,0">
                        <UniformGrid Columns="4">
                            <StackPanel>
                                <TextBlock Text="Suma Total Boletas:" FontSize="11.5" Foreground="#6B7280" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtGerenciaTotalBoletas" Text="S/ 0.00" FontSize="16" FontWeight="Bold" Foreground="#1F2937"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Suma Total Facturas:" FontSize="11.5" Foreground="#6B7280" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtGerenciaTotalFacturas" Text="S/ 0.00" FontSize="16" FontWeight="Bold" Foreground="#1F2937"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Total Propinas (Tarjeta):" FontSize="11.5" Foreground="#059669" FontWeight="Bold"/>
