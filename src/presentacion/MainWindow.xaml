                        <TextBlock x:Name="TxtLoginError" Text="Usuario o contraseña incorrectos" Foreground="#B91C1C"
                                   FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Usuario *" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtLoginUser" Height="34" Padding="10,0" FontSize="13.5" VerticalContentAlignment="Center"
                             Margin="0,0,0,10" GotFocus="TxtLoginUser_GotFocus" KeyDown="LoginInput_KeyDown"/>

                    <TextBlock Text="Contraseña (Clic para activar teclado alfanumérico) *" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,0,0,3"/>
                    <PasswordBox x:Name="PwdLoginPassword" Height="34" Padding="10,0" FontSize="15" VerticalContentAlignment="Center"
                                 Margin="0,0,0,10" GotFocus="PwdLoginPassword_GotFocus" PreviewMouseLeftButtonDown="PwdLoginPassword_MouseDown"
                                 KeyDown="LoginInput_KeyDown"/>

                    <Border x:Name="VirtualKeypadPanel" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1"
