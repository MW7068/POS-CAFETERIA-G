                            <TextBlock Text="☕" FontSize="30" HorizontalAlignment="Center"/>
                            <TextBlock Text="MAMÁ OLI" FontSize="8.5" FontWeight="ExtraBold" Foreground="#DC2626" HorizontalAlignment="Center"/>
