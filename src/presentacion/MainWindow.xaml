                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="🧾 Venta de Boleta o Factura" FontSize="19" FontWeight="Bold" Foreground="{StaticResource PrimaryRed}"/>
                            <TextBlock Text="Detalle de comprobantes emitidos con serie, tipo de pago, propina y suma total" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                        <Button Content="✕" Click="BtnCloseWinRepComprobantes_Click" HorizontalAlignment="Right" VerticalAlignment="Top"
