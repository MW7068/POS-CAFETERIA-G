                    </Border>

                    <TextBlock Text="Cafetería de Mamá Oli" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryRed}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Ingreso al Sistema Punto de Venta" FontSize="11.5" Foreground="{StaticResource TextMuted}"
                               HorizontalAlignment="Center" Margin="0,1,0,14"/>

                    <Border x:Name="BorderLoginError" Background="#FEE2E2" BorderBrush="#EF4444" BorderThickness="1"
