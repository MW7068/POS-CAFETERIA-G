                            <DataGridTextColumn Header="Consumo" Binding="{Binding TotalFormatted}" Width="85"/>
                            <DataGridTextColumn Header="Propina" Binding="{Binding TipFormatted}" Width="80"/>
                            <DataGridTextColumn Header="Cobrado" Binding="{Binding GrandTotalFormatted}" Width="90"/>
