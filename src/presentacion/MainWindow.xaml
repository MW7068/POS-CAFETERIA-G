                                    <Button Content="z" Style="{StaticResource FullKeypadButtonStyle}" Click="KeypadChar_Click"/>
                                    <Button Content="x" Style="{StaticResource FullKeypadButtonStyle}" Click="KeypadChar_Click"/>
                                    <Button Content="c" Style="{StaticResource FullKeypadButtonStyle}" Click="KeypadChar_Click"/>
                                    <Button Content="v" Style="{StaticResource FullKeypadButtonStyle}" Click="KeypadChar_Click"/>
                                    <Button Content="b" Style="{StaticResource FullKeypadButtonStyle}" Click="KeypadChar_Click"/>
                                    <Button Content="n" Style="{StaticResource FullKeypadButtonStyle}" Click="KeypadChar_Click"/>
                                    <Button Content="m" Style="{StaticResource FullKeypadButtonStyle}" Click="KeypadChar_Click"/>
                                </UniformGrid>
                                <Button Grid.Column="2" Content="⌫" Style="{StaticResource FullKeypadButtonStyle}" Click="KeypadBackspace_Click" ToolTip="Borrar carácter"/>
                            </Grid>

                            <Button Content="Limpiar Contraseña" Style="{StaticResource FullKeypadButtonStyle}" Height="28" FontSize="11" Click="KeypadClear_Click"/>
                        </StackPanel>
                    </Border>

                    <Button Content="Ingresar al Sistema" Click="BtnLoginSubmit_Click" Style="{StaticResource RedButtonStyle}" Height="38" FontSize="14"/>

                    <TextBlock Text="Demo: Usuario 'cajero' o 'admin' • Contraseña: '1234' o 'oli123'" FontSize="10.5"
                               Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
